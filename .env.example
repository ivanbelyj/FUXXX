# Messenger — переменные окружения сервиса.
#
# Этот файл — одновременно ШАБЛОН, из которого CI рендерит /opt/messenger/.env
# (.github/workflows/deploy.yml, шаг «Разложить .env»). Значения-заглушки (имена в
# двойных подчёркиваниях) подставляются из секретов GitHub по имени переменной:
#   AI_API_KEY   — главное (без него ИИ выключен, остальное работает);
#   AI_BASE_URL, AI_MODEL — по желанию: нет секрета — строки в .env нет и работает
#                  значение по умолчанию из server/config.js.
# Незамеченная заглушка валит деплой — «пустое значение» здесь хуже явной ошибки.
#
# Локально: скопируй файл в `.env`, замени заглушки своими значениями и запусти
# `node --env-file=.env server/index.js`. В git `.env` не попадает никогда:
# сервер читает переменные окружения, сам файл .env он не парсит.

PORT=8787
HOST=0.0.0.0

# --- AI (OpenAI-совместимый провайдер). КЛЮЧ ЖИВЁТ ТОЛЬКО НА СЕРВЕРЕ. ---
AI_BASE_URL=__AI_BASE_URL__
AI_API_KEY=__AI_API_KEY__
AI_MODEL=__AI_MODEL__
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.7

# --- Хранилище и лимиты (защита от абьюза) ---
DATA_DIR=./data
MAX_MESSAGE_CHARS=4000
MAX_BODY_BYTES=16777216
MAX_MEDIA_BYTES=8388608
MSGS_PER_MINUTE=60
ROOM_BUDGET_BYTES=50331648
HISTORY_LIMIT=500
AI_PER_HOUR=30

# --- Превью ссылок: белый список доменов ---
PREVIEW_WHITELIST=youtube.com,youtu.be,github.com,t.me,telegram.me,vk.com,max.ru
