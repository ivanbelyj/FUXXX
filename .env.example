# Скопируй в .env и заполни. Сервер читает переменные окружения (файл .env сам не парсит —
# передай их через systemd/docker/pm2 или `node --env-file=.env server/index.js`).

PORT=8787
HOST=0.0.0.0

# --- AI (OpenAI-совместимый провайдер). КЛЮЧ ЖИВЁТ ТОЛЬКО ЗДЕСЬ, НА СЕРВЕРЕ. ---
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-dcc9c8ac6ee5411182fdd102f7a97522
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.7

# --- Хранилище и лимиты (защита от абьюза) ---
DATA_DIR=./data
MAX_MESSAGE_CHARS=4000
MAX_BODY_BYTES=16777216
MAX_MEDIA_BYTES=8388608
MSGS_PER_MINUTE=60
ROOM_BUDGET_BYTES=50331648
HISTORY_LIMIT=500
AI_PER_HOUR=30

# --- Превью ссылок: белый список доменов ---
PREVIEW_WHITELIST=youtube.com,youtu.be,github.com,t.me,telegram.me,vk.com,max.ru
